<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="reisetech.student.management.repository.ApplicationStatusRepository">

  <!-- 申込状況の全件検索 -->
  <select id="search" resultType="reisetech.student.management.data.ApplicationStatus">
    SELECT *
    FROM application_statuses
  </select>

  <!-- 受講生コース情報IDに紐づく申込状況の検索 -->
  <select id="searchByStudentsCoursesId" resultType="reisetech.student.management.data.ApplicationStatus">
    SELECT *
    FROM application_statuses
    WHERE students_courses_id = #{studentsCoursesId}
  </select>

  <!-- 申込状況の登録 -->
  <insert id="registerApplicationStatus" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO application_statuses (students_courses_id, status)
    VALUES (#{studentsCoursesId}, #{status})
  </insert>

  <!-- 申込状況の更新 -->
  <update id="updateApplicationStatus">
    UPDATE application_statuses SET
    status = #{status}
    WHERE id = #{id}
  </update>
</mapper>